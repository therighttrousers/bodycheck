<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TestSessionTimeout>180000</TestSessionTimeout>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
    <EnvironmentVariables>
      <!-- The engine that scripts\dev-setup.ps1 installs, relative to the `game` directory. -->
      <GODOT_BIN>..\Godot\Godot.exe</GODOT_BIN>
    </EnvironmentVariables>
  </RunConfiguration>
  <GdUnit4>
    <!-- A fixed frame rate lets physics tick as fast as the machine allows, instead of in real time. -->
    <Parameters>--headless --fixed-fps 60</Parameters>
    <DisplayName>FullyQualifiedName</DisplayName>
  </GdUnit4>
</RunSettings>
