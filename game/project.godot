; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Body Check"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/main_scene="res://main/Main.tscn"
run/max_fps=60

[dotnet]

project/assembly_name="BodyCheck"
project/solution_directory=".."

[physics]

3d/physics_engine="Jolt Physics"
common/physics_jitter_fix=0
common/physics_ticks_per_second=60
common/physics_interpolation=true
jolt_physics_3d/collisions/collision_margin_fraction=0.005
jolt_physics_3d/simulation/penetration_slop=0.0
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.0