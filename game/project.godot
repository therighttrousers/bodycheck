; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Body Check"
run/main_scene="res://main/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="BodyCheck"
project/solution_directory=".."

[editor_overrides]

text_editor/behavior/indent/type=1

[physics]

common/physics_jitter_fix=0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.0
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.0
jolt_physics_3d/collisions/collision_margin_fraction=0.005
common/physics_interpolation=true
