; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Body Check"
run/main_scene="res://main/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60

[audio]

buses/default_bus_layout="uid://is4545waf157"

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960

[dotnet]

project/assembly_name="BodyCheck"
project/solution_directory=".."

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[filesystem]

import/blender/enabled=false

[importer_defaults]

scene={
"import_script/path": "res://look/nearest_textures_import.gd"
}

[layer_names]

3d_physics/layer_1="Static"
3d_physics/layer_2="Liquid"
3d_physics/layer_3="Trigger"
3d_physics/layer_4="Prop"
3d_physics/layer_5="Character"
3d_physics/layer_6="DoorStop"

[physics]

common/physics_jitter_fix=0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=16
jolt_physics_3d/simulation/penetration_slop=0.0
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.0
jolt_physics_3d/collisions/collision_margin_fraction=0.005
3d/default_gravity=28.125
common/physics_interpolation=true
