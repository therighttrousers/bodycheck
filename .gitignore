Godot_v*.zip
Godot/

# .NET build output
bin/
obj/

# Godot import cache
.godot/

# LDtk crash backups
game/levels/**/backups/

# gdUnit4Net test runner scene, written by the test adapter on each run
gdunit4_testadapter_v5/

# Copied from game/project.godot when the test project is built
tests/BodyCheck.Tests/project.godot

# A link to game/assets, made when the test project is built
/tests/BodyCheck.Tests/assets

# Godot writes an ID file for every script. Nothing refers to test classes by ID.
tests/BodyCheck.Tests/**/*.uid

tmp/

# Blender backups
*.blend1
